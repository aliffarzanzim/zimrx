# EditorConfig helps maintain consistent coding styles across different IDEs and editors.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,json,yml,yaml,md,cff}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.{db,sqlite,sqlite3,mp4,png,jpg,jpeg,gif,webp,ico,pdf,ttf,woff,woff2}]
insert_final_newline = false
trim_trailing_whitespace = false
